{
    "cmd": ["/opt/homebrew/bin/g++-15", "-std=c++20", "-O2", "-Wall", "-DLOCAL", "$file", "-o", "${file_path}/${file_base_name}"],
    "file_regex": "^(..[^:]*):([0-9]+):([0-9]+): (.*)$",
    "working_dir": "${file_path}",
    "selector": "source.c++, source.cpp",
    "variants": [
        {
            "name": "Run",
            "cmd": ["bash", "-c", "/opt/homebrew/bin/g++-15 -std=c++20 -O2 -Wall -DLOCAL '$file' -o '${file_path}/${file_base_name}' && '${file_path}/${file_base_name}'"]
        }
    ]
}